    given-names: Sebastien
    email: sebastian.rousseau@gmail.com
version: "0.0.12"
date-released: "2026-08-29"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/pacs008-mcp"
url: "https://pacs008.com"
keywords:
  - ISO 20022
  - pacs.008
  - credit transfer
  - CBPR+
  - Model Context Protocol
  - MCP
  - AI agents
  - banking
